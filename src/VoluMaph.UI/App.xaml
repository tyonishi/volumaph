<Application x:Class="VoluMaph.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:VoluMaph.UI"
             xmlns:converters="clr-namespace:VoluMaph.UI.ValueConverters"
             StartupUri="MainWindow.xaml"
             Startup="Application_Startup">
    <Application.Resources>
<ResourceDictionary>
                <!-- Global converters (available to merged dictionaries) -->
                <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
                <converters:CountToBoolConverter x:Key="CountToBoolConverter" />
                <converters:IconConverter x:Key="IconConverter" />
                <converters:SizeToColorConverter x:Key="ColorConverter" />
                <converters:SizeToHumanReadableConverter x:Key="SizeConverter" />
                <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/DarkTheme.xaml"/>
                <ResourceDictionary Source="Themes/DesignSystem.xaml"/>
                <ResourceDictionary Source="Themes/LightTheme.xaml"/>
                <ResourceDictionary Source="Themes/Spacing.xaml"/>
                <ResourceDictionary Source="Themes/Styles/Buttons.xaml"/>
                <ResourceDictionary Source="Themes/Styles/Cards.xaml"/>
                <ResourceDictionary Source="Themes/Styles/ComboBox.xaml"/>
                <ResourceDictionary Source="Themes/Styles/DataGrid.xaml"/>
                <ResourceDictionary Source="Themes/Styles/Expander.xaml"/>
                <ResourceDictionary Source="Themes/Styles/ProgressBar.xaml"/>
                <ResourceDictionary Source="Themes/Styles/TextBox.xaml"/>
                <ResourceDictionary Source="Themes/Styles/TreeView.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
