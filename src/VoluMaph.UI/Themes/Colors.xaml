<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="PrimaryDefault" Color="#0078D4"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#106EBE"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#005A9E"/>
    <SolidColorBrush x:Key="PrimaryDisabled" Color="#3C3C3C"/>

    <SolidColorBrush x:Key="SecondaryDefault" Color="#F3F2F1"/>
    <SolidColorBrush x:Key="SecondaryHover" Color="#EDEBE9"/>
    <SolidColorBrush x:Key="SecondaryPressed" Color="#E1DFDD"/>
    <SolidColorBrush x:Key="SecondaryDisabled" Color="#F3F2F1"/>

    <SolidColorBrush x:Key="DangerDefault" Color="#E81123"/>
    <SolidColorBrush x:Key="DangerHover" Color="#C50E1E"/>
    <SolidColorBrush x:Key="DangerPressed" Color="#A8000F"/>
    <SolidColorBrush x:Key="DangerDisabled" Color="#3C3C3C"/>

    <SolidColorBrush x:Key="WarningDefault" Color="#FFAA00"/>
    <SolidColorBrush x:Key="WarningHover" Color="#E59400"/>
    <SolidColorBrush x:Key="WarningPressed" Color="#CC8400"/>

    <SolidColorBrush x:Key="SuccessDefault" Color="#107C10"/>
    <SolidColorBrush x:Key="SuccessHover" Color="#0E5F0E"/>
    <SolidColorBrush x:Key="SuccessPressed" Color="#0B4A0B"/>

    <SolidColorBrush x:Key="InfoDefault" Color="#0078D4"/>
    <SolidColorBrush x:Key="InfoHover" Color="#106EBE"/>
    <SolidColorBrush x:Key="InfoPressed" Color="#005A9E"/>

    <SolidColorBrush x:Key="BorderDefault" Color="#8A8886"/>
    <SolidColorBrush x:Key="BorderHover" Color="#605E5C"/>
    <SolidColorBrush x:Key="BorderFocus" Color="#0078D4"/>

    <SolidColorBrush x:Key="FocusIndicator" Color="#605E5C"/>
    <SolidColorBrush x:Key="FocusIndicatorDark" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusBorderColor" Color="#0078D4"/>
    <SolidColorBrush x:Key="FocusBorderColorDark" Color="#60CDFF"/>
    <Thickness x:Key="FocusVisualPrimaryThickness">2</Thickness>
    <Thickness x:Key="FocusVisualSecondaryThickness">1</Thickness>

</ResourceDictionary>
