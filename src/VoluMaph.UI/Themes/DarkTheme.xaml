<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#666666"/>

    <SolidColorBrush x:Key="PrimaryDefault" Color="#0078D4"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#106EBE"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#005A9E"/>
    <SolidColorBrush x:Key="PrimaryDisabled" Color="#3C3C3C"/>

    <SolidColorBrush x:Key="SecondaryDefault" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="SecondaryHover" Color="#4D4D4D"/>
    <SolidColorBrush x:Key="SecondaryPressed" Color="#5A5A5A"/>

    <SolidColorBrush x:Key="DangerDefault" Color="#E81123"/>
    <SolidColorBrush x:Key="DangerHover" Color="#C50E1E"/>
    <SolidColorBrush x:Key="DangerPressed" Color="#A8000F"/>

    <SolidColorBrush x:Key="WarningDefault" Color="#FFAA00"/>
    <SolidColorBrush x:Key="WarningHover" Color="#E59400"/>
    <SolidColorBrush x:Key="WarningPressed" Color="#CC8400"/>

    <SolidColorBrush x:Key="SuccessDefault" Color="#107C10"/>
    <SolidColorBrush x:Key="SuccessHover" Color="#0E5F0E"/>
    <SolidColorBrush x:Key="SuccessPressed" Color="#0B4A0B"/>

    <SolidColorBrush x:Key="InfoDefault" Color="#0078D4"/>
    <SolidColorBrush x:Key="InfoHover" Color="#106EBE"/>
    <SolidColorBrush x:Key="InfoPressed" Color="#005A9E"/>

    <SolidColorBrush x:Key="BorderDefault" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="BorderHover" Color="#8A8886"/>
    <SolidColorBrush x:Key="BorderFocus" Color="#0078D4"/>

    <SolidColorBrush x:Key="GridLineBrush" Color="#3A3A3A"/>

    <SolidColorBrush x:Key="Highlight" Color="#0078D4"/>
    <SolidColorBrush x:Key="HighlightText" Color="#FFFFFF"/>

</ResourceDictionary>
