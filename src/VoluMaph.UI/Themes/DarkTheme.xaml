<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Fluent Design Dark Theme -->
    <!-- Based on WinUI 3 Color Palette -->

    <!-- Background Colors -->
    <SolidColorBrush x:Key="WindowBackground" Color="#202020"/>
    <SolidColorBrush x:Key="WindowBackgroundAlt" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ControlBackgroundAlt" Color="#383838"/>
    <SolidColorBrush x:Key="SubtleBackground" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="SubtleBackgroundHover" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SubtleBackgroundPressed" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="LayerBackground" Color="#382D2D2D"/>
    <SolidColorBrush x:Key="CardBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SmokeFillColorDefault" Color="#4D000000"/>

    <!-- Text Colors (WCAG AA compliant) -->
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C5C5C5"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#9D9D9D"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#5D5D5D"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#000000"/>

    <!-- Accent Colors (Windows 11 Default Blue - Light variants for dark theme) -->
    <SolidColorBrush x:Key="AccentDefault" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentLight1" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentLight2" Color="#98ECFF"/>
    <SolidColorBrush x:Key="AccentLight3" Color="#C0F7FF"/>
    <SolidColorBrush x:Key="AccentDark1" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentDark2" Color="#005FB7"/>
    <SolidColorBrush x:Key="AccentDark3" Color="#003D92"/>

    <!-- Primary Button Colors -->
    <SolidColorBrush x:Key="PrimaryDefault" Color="#60CDFF"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#98ECFF"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#47B1E0"/>
    <SolidColorBrush x:Key="PrimaryDisabled" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="PrimaryForeground" Color="#000000"/>

    <!-- Secondary/Subtle Button Colors -->
    <SolidColorBrush x:Key="SecondaryDefault" Color="#0FFFFFFF"/>
    <SolidColorBrush x:Key="SecondaryHover" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryPressed" Color="#08FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryDisabled" Color="#0AFFFFFF"/>

    <!-- Danger/Critical Colors -->
    <SolidColorBrush x:Key="DangerDefault" Color="#FF99A4"/>
    <SolidColorBrush x:Key="DangerHover" Color="#FFBFC5"/>
    <SolidColorBrush x:Key="DangerPressed" Color="#E87580"/>
    <SolidColorBrush x:Key="DangerBackground" Color="#442726"/>

    <!-- Warning/Caution Colors -->
    <SolidColorBrush x:Key="WarningDefault" Color="#FCE100"/>
    <SolidColorBrush x:Key="WarningHover" Color="#FFF163"/>
    <SolidColorBrush x:Key="WarningPressed" Color="#D4BD00"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#433519"/>

    <!-- Success Colors -->
    <SolidColorBrush x:Key="SuccessDefault" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="SuccessHover" Color="#89DB7F"/>
    <SolidColorBrush x:Key="SuccessPressed" Color="#54B347"/>
    <SolidColorBrush x:Key="SuccessBackground" Color="#393D1B"/>

    <!-- Info Colors -->
    <SolidColorBrush x:Key="InfoDefault" Color="#60CDFF"/>
    <SolidColorBrush x:Key="InfoHover" Color="#98ECFF"/>
    <SolidColorBrush x:Key="InfoPressed" Color="#47B1E0"/>
    <SolidColorBrush x:Key="InfoBackground" Color="#24344D"/>

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderDefault" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="BorderHover" Color="#545454"/>
    <SolidColorBrush x:Key="BorderFocus" Color="#60CDFF"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#757575"/>
    <SolidColorBrush x:Key="CardBorder" Color="#1EFFFFFF"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="ControlBorderInput" Color="#8AFFFFFF"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF"/>

    <!-- Grid/Table Colors -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#383838"/>
    <SolidColorBrush x:Key="GridHeaderBackground" Color="#323232"/>
    <SolidColorBrush x:Key="GridRowAlternate" Color="#282828"/>

    <!-- Selection/Highlight Colors -->
    <SolidColorBrush x:Key="Highlight" Color="#60CDFF"/>
    <SolidColorBrush x:Key="HighlightText" Color="#000000"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#2E4A5F"/>
    <SolidColorBrush x:Key="SelectionBackgroundPressed" Color="#264052"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#3A3A3A"/>

    <!-- Focus Indicator -->
    <SolidColorBrush x:Key="FocusBorderColor" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FocusSecondaryBorder" Color="#000000"/>

    <!-- Scrollbar Colors -->
    <SolidColorBrush x:Key="ScrollbarThumb" Color="#5A5A5A"/>
    <SolidColorBrush x:Key="ScrollbarThumbHover" Color="#707070"/>
    <SolidColorBrush x:Key="ScrollbarTrack" Color="#2A2A2A"/>

    <!-- Shadow/Elevation -->
    <Color x:Key="ShadowColor">#33000000</Color>

</ResourceDictionary>
