<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <sys:Double x:Key="SpacingXXS">4</sys:Double>
    <sys:Double x:Key="SpacingXS">8</sys:Double>
    <sys:Double x:Key="SpacingS">12</sys:Double>
    <sys:Double x:Key="SpacingM">16</sys:Double>
    <sys:Double x:Key="SpacingL">24</sys:Double>
    <sys:Double x:Key="SpacingXL">32</sys:Double>
    <sys:Double x:Key="SpacingXXL">48</sys:Double>

    <sys:Double x:Key="CornerRadiusSmall">4</sys:Double>
    <sys:Double x:Key="CornerRadiusMedium">8</sys:Double>
    <sys:Double x:Key="CornerRadiusLarge">12</sys:Double>

    <CornerRadius x:Key="CornerRadius4">4,4,4,4</CornerRadius>
    <CornerRadius x:Key="CornerRadius8">8,8,8,8</CornerRadius>
    <CornerRadius x:Key="CornerRadius12">12,12,12,12</CornerRadius>

    <Thickness x:Key="ThicknessXXS">4,4,4,4</Thickness>
    <Thickness x:Key="ThicknessXS">8,8,8,8</Thickness>
    <Thickness x:Key="ThicknessS">12,12,12,12</Thickness>
    <Thickness x:Key="ThicknessM">16,8,16,8</Thickness>
    <Thickness x:Key="ThicknessL">24,12,24,12</Thickness>
    <Thickness x:Key="ThicknessXL">32,16,32,16</Thickness>

    <Thickness x:Key="BorderThicknessThin">1,1,1,1</Thickness>
    <Thickness x:Key="BorderThicknessThick">2,2,2,2</Thickness>

    <sys:Double x:Key="IconSizeSmall">16</sys:Double>
    <sys:Double x:Key="IconSizeMedium">20</sys:Double>
    <sys:Double x:Key="IconSizeLarge">24</sys:Double>

    <DropShadowEffect x:Key="CardDropShadow"
                      Color="Black"
                      Opacity="0.15"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"/>

</ResourceDictionary>
