<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DropShadowEffect x:Key="CardDropShadow"
                      Color="Black"
                      Opacity="0.15"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"/>

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}"/>
        <Setter Property="BorderThickness" Value="1,1,1,1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="12"/>
        <Setter Property="Effect" Value="{StaticResource CardDropShadow}"/>
    </Style>

    <Style x:Key="SummaryCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Padding" Value="24,12"/>
        <Setter Property="Margin" Value="16"/>
    </Style>

    <Style x:Key="FilterCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
        <Setter Property="Margin" Value="0"/>
    </Style>

</ResourceDictionary>
