<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Windows 11 Fluent Design Light Theme -->
    <!-- Based on WinUI 3 Color Palette -->

    <!-- Background Colors -->
    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="WindowBackgroundAlt" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlBackgroundAlt" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="SubtleBackground" Color="#0A000000"/>
    <SolidColorBrush x:Key="SubtleBackgroundHover" Color="#09000000"/>
    <SolidColorBrush x:Key="SubtleBackgroundPressed" Color="#06000000"/>
    <SolidColorBrush x:Key="LayerBackground" Color="#80FFFFFF"/>
    <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SmokeFillColorDefault" Color="#4D000000"/>

    <!-- Text Colors (WCAG AA compliant) -->
    <SolidColorBrush x:Key="TextPrimary" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#5E5E5E"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="TextDisabled" Color="#C4C4C4"/>
    <SolidColorBrush x:Key="TextOnAccent" Color="#FFFFFF"/>

    <!-- Accent Colors (Windows 11 Default Blue) -->
    <SolidColorBrush x:Key="AccentDefault" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentLight1" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentLight2" Color="#98ECFF"/>
    <SolidColorBrush x:Key="AccentLight3" Color="#C0F7FF"/>
    <SolidColorBrush x:Key="AccentDark1" Color="#005FB7"/>
    <SolidColorBrush x:Key="AccentDark2" Color="#003D92"/>
    <SolidColorBrush x:Key="AccentDark3" Color="#001968"/>

    <!-- Primary Button Colors -->
    <SolidColorBrush x:Key="PrimaryDefault" Color="#0078D4"/>
    <SolidColorBrush x:Key="PrimaryHover" Color="#005FB7"/>
    <SolidColorBrush x:Key="PrimaryPressed" Color="#003D92"/>
    <SolidColorBrush x:Key="PrimaryDisabled" Color="#BDBDBD"/>

    <!-- Secondary/Subtle Button Colors -->
    <SolidColorBrush x:Key="SecondaryDefault" Color="#0A000000"/>
    <SolidColorBrush x:Key="SecondaryHover" Color="#15000000"/>
    <SolidColorBrush x:Key="SecondaryPressed" Color="#08000000"/>
    <SolidColorBrush x:Key="SecondaryDisabled" Color="#05000000"/>

    <!-- Danger/Critical Colors -->
    <SolidColorBrush x:Key="DangerDefault" Color="#C42B1C"/>
    <SolidColorBrush x:Key="DangerHover" Color="#B52A1C"/>
    <SolidColorBrush x:Key="DangerPressed" Color="#9E231A"/>
    <SolidColorBrush x:Key="DangerBackground" Color="#FDE7E9"/>

    <!-- Warning/Caution Colors -->
    <SolidColorBrush x:Key="WarningDefault" Color="#9D5D00"/>
    <SolidColorBrush x:Key="WarningHover" Color="#8A5200"/>
    <SolidColorBrush x:Key="WarningPressed" Color="#754600"/>
    <SolidColorBrush x:Key="WarningBackground" Color="#FFF4CE"/>

    <!-- Success Colors -->
    <SolidColorBrush x:Key="SuccessDefault" Color="#0F7B0F"/>
    <SolidColorBrush x:Key="SuccessHover" Color="#0E6E0E"/>
    <SolidColorBrush x:Key="SuccessPressed" Color="#0C5E0C"/>
    <SolidColorBrush x:Key="SuccessBackground" Color="#DFF6DD"/>

    <!-- Info Colors -->
    <SolidColorBrush x:Key="InfoDefault" Color="#0078D4"/>
    <SolidColorBrush x:Key="InfoHover" Color="#005FB7"/>
    <SolidColorBrush x:Key="InfoPressed" Color="#003D92"/>
    <SolidColorBrush x:Key="InfoBackground" Color="#F0F6FC"/>

    <!-- Border Colors -->
    <SolidColorBrush x:Key="BorderDefault" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="BorderHover" Color="#C4C4C4"/>
    <SolidColorBrush x:Key="BorderFocus" Color="#0078D4"/>
    <SolidColorBrush x:Key="BorderStrong" Color="#ABABAB"/>
    <SolidColorBrush x:Key="CardBorder" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ControlBorder" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ControlBorderInput" Color="#8B8B8B"/>
    <SolidColorBrush x:Key="DividerBrush" Color="#0F000000"/>

    <!-- Grid/Table Colors -->
    <SolidColorBrush x:Key="GridLineBrush" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="GridHeaderBackground" Color="#FAFAFA"/>
    <SolidColorBrush x:Key="GridRowAlternate" Color="#F9F9F9"/>

    <!-- Selection/Highlight Colors -->
    <SolidColorBrush x:Key="Highlight" Color="#0078D4"/>
    <SolidColorBrush x:Key="HighlightText" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SelectionBackground" Color="#CCE4F7"/>
    <SolidColorBrush x:Key="SelectionBackgroundPressed" Color="#B3D9F2"/>
    <SolidColorBrush x:Key="HoverBackground" Color="#E8E8E8"/>

    <!-- Focus Indicator -->
    <SolidColorBrush x:Key="FocusBorderColor" Color="#0078D4"/>
    <SolidColorBrush x:Key="FocusSecondaryBorder" Color="#FFFFFF"/>

    <!-- Scrollbar Colors -->
    <SolidColorBrush x:Key="ScrollbarThumb" Color="#CDCDCD"/>
    <SolidColorBrush x:Key="ScrollbarThumbHover" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="ScrollbarTrack" Color="#F0F0F0"/>

    <!-- Shadow/Elevation -->
    <Color x:Key="ShadowColor">#29000000</Color>

</ResourceDictionary>
