<UserControl x:Class="VoluMaph.UI.Controls.ToastNotification"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="48" d:DesignWidth="320"
             HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,16,0,0">
    <Grid>
        <Border Background="{DynamicResource ControlBackground}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16"
                MinWidth="280"
                MaxWidth="400"
                RenderTransformOrigin="0.5,0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="ToastSlide" Y="-100"/>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="ToastSlide"
                                           Storyboard.TargetProperty="Y"
                                           To="0"
                                           Duration="0:0:0.3">
                                <DoubleAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="20"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Text="{Binding Icon, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Foreground="{Binding IconColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                           Style="{StaticResource BodyTextStyle}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="300"/>

                <Button Grid.Column="2"
                        Click="Close_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Width="24"
                        Height="24"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Text="&#xE106;"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
