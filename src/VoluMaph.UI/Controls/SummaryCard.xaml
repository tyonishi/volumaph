<UserControl x:Class="VoluMaph.UI.Controls.SummaryCard"
             x:Name="ThisControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Caption style for card labels -->
        <Style x:Key="CardCaptionStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Small, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="LineHeight" Value="16"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
        </Style>
        <!-- Large value display style -->
        <Style x:Key="CardValueStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <!-- Subtitle style with visibility trigger -->
        <Style x:Key="CardSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Small, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="LineHeight" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}"/>
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Subtitle, ElementName=ThisControl}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Subtitle, ElementName=ThisControl}" Value="">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="20,16"
            MinHeight="100">
        <Border.Effect>
            <DropShadowEffect Color="#29000000"
                              Opacity="0.08"
                              BlurRadius="12"
                              ShadowDepth="2"
                              Direction="270"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title/Label -->
            <TextBlock Grid.Row="0"
                       Text="{Binding Title, ElementName=ThisControl}"
                       Style="{StaticResource CardCaptionStyle}"
                       TextTrimming="CharacterEllipsis"/>

            <!-- Value -->
            <TextBlock Grid.Row="1"
                       Text="{Binding Value, ElementName=ThisControl}"
                       Style="{StaticResource CardValueStyle}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Margin="0,8,0,4"/>

            <!-- Subtitle (optional) -->
            <TextBlock Grid.Row="2"
                       Text="{Binding Subtitle, ElementName=ThisControl}"
                       Style="{StaticResource CardSubtitleStyle}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="180"/>
        </Grid>
    </Border>
</UserControl>