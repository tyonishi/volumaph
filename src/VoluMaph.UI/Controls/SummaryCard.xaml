  <UserControl x:Class="VoluMaph.UI.Controls.SummaryCard"
               x:Name="ThisControl"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="LineHeight" Value="16"/>
        </Style>
        <Style x:Key="Header2TextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="LineHeight" Value="28"/>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource SummaryCardStyle}">
      <StackPanel Margin="8" VerticalAlignment="Center">
       <TextBlock Text="{Binding Title, ElementName=ThisControl}"
                  Style="{StaticResource CaptionTextStyle}"
                  Foreground="{DynamicResource TextSecondary}"
                  HorizontalAlignment="Left"/>
       <TextBlock Text="{Binding Value, ElementName=ThisControl}"
                  Style="{StaticResource Header2TextStyle}"
                   Margin="0,8,0,0"
                  HorizontalAlignment="Right"/>
       <TextBlock Text="{Binding Subtitle, ElementName=ThisControl}"
                  Style="{StaticResource CaptionTextStyle}"
                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"
                  HorizontalAlignment="Left"/>
     </StackPanel>
   </Border>
 </UserControl>