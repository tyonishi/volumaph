<UserControl x:Class="VoluMaph.UI.Controls.SunburstControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:VoluMaph.UI.Behaviors"
    xmlns:local="clr-namespace:VoluMaph.UI.Controls">
    <Grid>
        <Border x:Name="ZoomContainer">
            <Canvas x:Name="SunburstCanvas"
                    ClipToBounds="True" />
        </Border>
        <Border x:Name="TooltipBorder"
                Background="#CC000000"
                BorderBrush="#FFCCCCCC"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock x:Name="TooltipName"
                          Foreground="White"
                          FontWeight="Bold"
                          TextWrapping="Wrap" />
                <TextBlock x:Name="TooltipSize"
                          Foreground="White"
                          Margin="0,4,0,0" />
                <TextBlock x:Name="TooltipPath"
                          Foreground="LightGray"
                          FontSize="11"
                          Margin="0,2,0,0"
                          TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border x:Name="BreadcrumbBorder"
                Background="#E0FFFFFF"
                BorderBrush="#CC000000"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Visibility="Collapsed">
            <ItemsControl x:Name="BreadcrumbItems" />
        </Border>
    </Grid>
</UserControl>
