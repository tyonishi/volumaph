<UserControl x:Class="VoluMaph.UI.Controls.TreemapControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:VoluMaph.UI.Behaviors"
    xmlns:local="clr-namespace:VoluMaph.UI.Controls">
    <Grid>
        <Border x:Name="ZoomContainer"
                Background="{Binding Background, RelativeSource={RelativeSource AncestorType=local:TreemapControl}}"
                BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=local:TreemapControl}}"
                BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=local:TreemapControl}}">
            <Canvas x:Name="TreemapCanvas"
                    ClipToBounds="True" />
        </Border>
    </Grid>
</UserControl>
