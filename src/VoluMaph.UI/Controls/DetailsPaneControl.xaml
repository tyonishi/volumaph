<UserControl x:Class="VoluMaph.UI.Controls.DetailsPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoluMaph.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" xmlns:converters="clr-namespace:VoluMaph.UI.ValueConverters">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:IconConverter x:Key="IconConverter"/>
        <converters:SizeToHumanReadableConverter x:Key="SizeConverter"/>
        <converters:SizeToColorConverter x:Key="ColorConverter"/>
        <Style x:Key="SizeCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Size, Converter={StaticResource ColorConverter}}"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="InnerDataGrid" Grid.Row="0"
                  ItemsSource="{Binding ChildrenView}"
                  AutoGenerateColumns="False"
                  Background="{DynamicResource WindowBackground}"
                  Foreground="{DynamicResource TextPrimary}"
                  Style="{StaticResource FluentDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource FluentDataGridColumnHeaderStyle}"
                  CellStyle="{StaticResource FluentDataGridCellStyle}"
                  RowStyle="{StaticResource FluentDataGridRowStyle}"
                  Sorting="InnerDataGrid_Sorting"
                  IsReadOnly="True"
                  AutomationProperties.Name="File Data Grid"
                  AutomationProperties.HelpText="Displays files and folders with sortable columns"
                  ToolTip="View files and folders - Right-click for options, click headers to sort"
                  Visibility="{Binding ShowVisualization, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}">
            <DataGrid.ContextMenu>
                <ContextMenu Background="{DynamicResource ControlBackground}" Foreground="{DynamicResource TextPrimary}">
                    <MenuItem Header="Open in Explorer" Command="{Binding OpenInExplorerCommand}" ToolTip="Open selected item in Windows Explorer"/>
                    <Separator/>
                    <MenuItem Header="Copy Path" Command="{Binding CopyPathCommand}" ToolTip="Copy full path to clipboard"/>
                    <MenuItem Header="Copy Name" Command="{Binding CopyNameCommand}" ToolTip="Copy name to clipboard"/>
                    <Separator/>
                    <MenuItem Header="Export to CSV" Command="{Binding ExportToCsvCommand}" ToolTip="Export current view to CSV file"/>
                    <MenuItem Header="Export to HTML" Command="{Binding ExportToHtmlCommand}" ToolTip="Export current view to HTML file"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" SortMemberPath="Name" Width="*" Visibility="Visible">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
                            <Setter Property="Text" Value="{Binding Name, Converter={StaticResource IconConverter}, StringFormat={}{0}  }"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Size" Binding="{Binding Size, Converter={StaticResource SizeConverter}}" SortMemberPath="Size" Width="120" Visibility="Visible">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SizeCellStyle}">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,12,0"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridColumn.SortDirection>Descending</DataGridColumn.SortDirection>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Path" Binding="{Binding FullPath, Mode=OneWay}" SortMemberPath="FullPath" Width="*" Visibility="Visible" IsReadOnly="True">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}"/>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="0" Visibility="{Binding ShowVisualization, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="Treemap" Command="{Binding VisualizationViewModel.ToggleVisualizationModeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="4"
                        Visibility="{Binding VisualizationViewModel.IsSunburstMode, Converter={StaticResource BoolToVisibilityConverter}}"/>
                <Button Content="Sunburst" Command="{Binding VisualizationViewModel.ToggleVisualizationModeCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="4"
                        Visibility="{Binding VisualizationViewModel.IsSunburstMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"/>
                <Button Content="Zoom In" Command="{Binding VisualizationViewModel.ZoomInCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="4"/>
                <Button Content="Zoom Out" Command="{Binding VisualizationViewModel.ZoomOutCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="4"/>
                <Button Content="Reset Zoom" Command="{Binding VisualizationViewModel.ResetZoomCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" Margin="4"/>

                <TextBlock Text="Theme:" VerticalAlignment="Center" Margin="12,0,8,0" Style="{StaticResource BodyTextStyle}" Foreground="{DynamicResource TextSecondary}"/>
                <ComboBox Width="130" ItemsSource="{Binding AvailableColorThemes}" SelectedItem="{Binding ColorTheme}" Style="{StaticResource FluentComboBoxStyle}" VerticalAlignment="Center" Margin="0,0,4,0"/>
            </StackPanel>

            <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <controls:TreemapControl x:Name="TreemapControl" Margin="8" Visibility="{Binding DataContext.VisualizationViewModel.IsSunburstMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}" DataContext="{Binding DataContext.VisualizationViewModel.RootFolder, RelativeSource={RelativeSource AncestorType=Window}}" ColorTheme="{Binding DataContext.VisualizationViewModel.ColorTheme, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    <controls:SunburstControl x:Name="SunburstControl" Margin="8" Visibility="{Binding DataContext.VisualizationViewModel.IsSunburstMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}" DataContext="{Binding DataContext.VisualizationViewModel.RootFolder, RelativeSource={RelativeSource AncestorType=Window}}" ColorTheme="{Binding DataContext.VisualizationViewModel.ColorTheme, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>