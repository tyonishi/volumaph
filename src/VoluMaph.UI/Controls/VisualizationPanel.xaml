<UserControl x:Class="VoluMaph.UI.Controls.VisualizationPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:VoluMaph.UI.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Treemap" Command="{Binding VisualizationViewModel.ToggleVisualizationModeCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="4"
                    Visibility="{Binding VisualizationViewModel.IsSunburstMode, Converter={StaticResource BoolToVisibilityConverter}}"
                    AutomationProperties.Name="Treemap Button"
                    AutomationProperties.HelpText="Switch to treemap visualization"/>
            <Button Content="Sunburst" Command="{Binding VisualizationViewModel.ToggleVisualizationModeCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="4"
                    Visibility="{Binding VisualizationViewModel.IsSunburstMode, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                    AutomationProperties.Name="Sunburst Button"
                    AutomationProperties.HelpText="Switch to sunburst visualization"/>
            <Button Content="Zoom In" Command="{Binding VisualizationViewModel.ZoomInCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="4"
                    AutomationProperties.Name="Zoom In Button"
                    AutomationProperties.HelpText="Zoom in"/>
            <Button Content="Zoom Out" Command="{Binding VisualizationViewModel.ZoomOutCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="4"
                    AutomationProperties.Name="Zoom Out Button"
                    AutomationProperties.HelpText="Zoom out"/>
            <Button Content="Reset Zoom" Command="{Binding VisualizationViewModel.ResetZoomCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" Margin="4"
                    AutomationProperties.Name="Reset Zoom Button"
                    AutomationProperties.HelpText="Reset zoom to default"/>

            <!-- Color Theme Label and ComboBox -->
            <TextBlock Text="Theme:"
                       VerticalAlignment="Center"
                       Margin="12,0,8,0"
                       Style="{StaticResource BodyTextStyle}"
                       Foreground="{DynamicResource TextSecondary}"/>
            <ComboBox Width="130"
                      ItemsSource="{Binding AvailableColorThemes}"
                      SelectedItem="{Binding ColorTheme}"
                      Style="{StaticResource FluentComboBoxStyle}"
                      AutomationProperties.Name="Color Theme Selection"
                      AutomationProperties.HelpText="Select color theme for visualization"
                      ToolTip="Select color theme for visualization"
                      VerticalAlignment="Center"
                      Margin="0,0,4,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource ControlBackground}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <controls:TreemapControl x:Name="TreemapControl"
                                         Margin="8"
                                         Visibility="{Binding DataContext.VisualizationViewModel.IsSunburstMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverse}"
                                         DataContext="{Binding DataContext.VisualizationViewModel.RootFolder, RelativeSource={RelativeSource AncestorType=Window}}"
                                         ColorTheme="{Binding DataContext.VisualizationViewModel.ColorTheme, RelativeSource={RelativeSource AncestorType=Window}}"/>
                <controls:SunburstControl x:Name="SunburstControl"
                                          Margin="8"
                                          Visibility="{Binding DataContext.VisualizationViewModel.IsSunburstMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}"
                                          DataContext="{Binding DataContext.VisualizationViewModel.RootFolder, RelativeSource={RelativeSource AncestorType=Window}}"
                                          ColorTheme="{Binding DataContext.VisualizationViewModel.ColorTheme, RelativeSource={RelativeSource AncestorType=Window}}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
