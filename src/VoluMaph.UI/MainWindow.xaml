<Window x:Class="VoluMaph.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VoluMaph.UI"
        
        xmlns:helpers="clr-namespace:VoluMaph.UI.Helpers"
        xmlns:ui="clr-namespace:VoluMaph.UI.Controls"
        mc:Ignorable="d"
        Title="VoluMaph" Height="750" Width="1280"
        MinHeight="600" MinWidth="900"
        Background="{DynamicResource WindowBackground}"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    <Window.Resources>
        <Style x:Key="SizeCellStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding Size, Converter={StaticResource ColorConverter}}"/>
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ExportToCsvCommand}"/>
        <KeyBinding Key="F" Modifiers="Control"/>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}"/>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="F5" Modifiers="Control" Command="{Binding ScanCommand}"/>
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding ToggleThemeCommand}"/>
        <KeyBinding Key="Home" Command="{Binding VisualizationViewModel.ResetZoomCommand}"/>
        <KeyBinding Key="End" Command="{Binding VisualizationViewModel.MaxZoomCommand}"/>
    </Window.InputBindings>

    <Grid Name="MainGrid" AllowDrop="True" Drop="Grid_Drop" DragOver="Grid_DragOver"
         Background="{DynamicResource WindowBackground}"
         KeyDown="Window_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Canvas Grid.RowSpan="5" Name="ToastCanvas" Panel.ZIndex="9999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

        <ui:CommandBarControl Grid.Row="0" x:Name="CommandBar"/>


        <!-- Summary Panel (extracted) -->
        <ui:SummaryPanel Grid.Row="1" Margin="16,12,16,0"/>

        <!-- Filters Panel (extracted) -->
        <ui:FiltersPanel Grid.Row="2" Margin="16,8,16,0"/>


        <!-- Main Content Area -->
        <Grid Grid.Row="3" Margin="16,12,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="280"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="3*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Grid Splitter with subtle styling -->
            <GridSplitter Grid.Column="1"
                          Width="6"
                          Background="Transparent"
                          HorizontalAlignment="Center"
                          ShowsPreview="True"
                          Cursor="SizeWE">
                <GridSplitter.Template>
                    <ControlTemplate TargetType="GridSplitter">
                        <Border Background="Transparent" Padding="2,0">
                            <Rectangle Width="2"
                                       Fill="{DynamicResource DividerBrush}"
                                       RadiusX="1"
                                       RadiusY="1"/>
                        </Border>
                    </ControlTemplate>
                </GridSplitter.Template>
            </GridSplitter>

            <ui:FolderTreeControl Grid.Column="0" x:Name="FolderTree"/>
            <ui:DetailsPaneControl Grid.Column="2" x:Name="DetailsPane"/>
        </Grid>


        <!-- Modern Status Bar (extracted) -->
        <ui:StatusBarControl Grid.Row="4"/>
    </Grid>
</Window>
